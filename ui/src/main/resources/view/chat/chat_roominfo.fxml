<?import io.xeres.ui.custom.DisclosedHyperlink?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="io.xeres.ui.controller.chat.ChatRoomInfoController">
    <padding>
        <Insets bottom="8.0" left="8.0" right="8.0" top="8.0"/>
    </padding>
    <GridPane fx:id="roomGroup">
        <columnConstraints>
            <ColumnConstraints hgrow="NEVER" minWidth="10.0" prefWidth="100.0"/>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0"/>
        </columnConstraints>
        <rowConstraints>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES"/>
        </rowConstraints>
        <Label text="%name"/>
        <Label fx:id="roomName" GridPane.columnIndex="1"/>
        <Label text="%chat.room.id" GridPane.rowIndex="1"/>
        <Label fx:id="roomId" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="%chat.room.topic" GridPane.rowIndex="2"/>
        <Label fx:id="roomTopic" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Label text="%chat.room.security" GridPane.rowIndex="3"/>
        <Label fx:id="roomSecurity" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        <Label text="%chat.room.users" GridPane.rowIndex="4"/>
        <Label fx:id="roomCount" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
    </GridPane>
    <StackPane fx:id="emptyGroup" VBox.vgrow="ALWAYS">
        <!-- Keep VBox sized to its content -->
        <VBox spacing="8" alignment="CENTER" maxWidth="-Infinity" maxHeight="-Infinity" minWidth="-Infinity" minHeight="-Infinity">
            <TextFlow maxWidth="250" lineSpacing="6">
                <Text text="%chat.room.help.create"/>
                <Text text=" "/>
                <FontIcon iconLiteral="mdi2c-chat-plus"/>
                <Text text="%full-stop-dot"/>
                <Text text="&#10;"/>
                <Text text="%chat.room.help.select-existing"/>
            </TextFlow>
            <DisclosedHyperlink fx:id="helpLink" text="%chat.room.help.link"/>
        </VBox>
    </StackPane>
</VBox>
