<?import io.xeres.ui.custom.DisclosedHyperlink?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<fx:root type="Tab" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <graphic>
        <FontIcon fx:id="icon" iconLiteral="mdi2f-folder-plus"/>
    </graphic>
    <VBox>
        <StackPane VBox.vgrow="ALWAYS">
            <!-- Keep VBox sized to its content -->
            <VBox spacing="8" alignment="CENTER" maxWidth="-Infinity" maxHeight="-Infinity" minWidth="-Infinity" minHeight="-Infinity">
                <TextFlow maxWidth="250" lineSpacing="6">
                    <Text text="%stickers.help.directory"/>
                    <Text text="&#10;"/>
                    <FontIcon iconLiteral="mdi2f-folder"/>
                    <Text text=" 01.People"/>
                    <Text text="&#10;"/>
                    <FontIcon iconLiteral="mdi2f-folder"/>
                    <Text text=" 02.Food"/>
                </TextFlow>
                <DisclosedHyperlink fx:id="stickersDirectory" text="%stickers.help.add"/>
                <DisclosedHyperlink fx:id="helpLink" text="%stickers.help.link"/>
            </VBox>
        </StackPane>
    </VBox>
</fx:root>